#include "version.h"
1 ICON "bce.ico"
1 VERSIONINFO
FILEVERSION APP_VERSION_NUM
PRODUCTVERSION APP_VERSION_NUM
FILEOS 0x40004
FILETYPE 1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Black Cauldron Enhanced - plays Sierra's The Black Cauldron on Windows"
      VALUE "FileVersion", APP_VERSION
      VALUE "ProductName", "Black Cauldron Enhanced"
      VALUE "ProductVersion", APP_VERSION
      VALUE "OriginalFilename", "BC-Enhanced.exe"
      VALUE "LegalCopyright", "(c) 2026 Zwarteziel, GPL-3.0-or-later. Game (c) Sierra On-Line / Disney - not included."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
